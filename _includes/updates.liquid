<h2>
  <a href="{{ '/news/' | relative_url }}" style="color: inherit">recent updates</a>
</h2>

<div class="updates-container">
  {% if site.data.updates %}
    <ul class="news-timeline">
      {% for update in site.data.updates %}
        <li class="news-timeline-item">
          <div class="news-timeline-date">{{ update.date }}</div>
          <div class="news-timeline-content">{{ update.content }}</div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No updates available.</p>
  {% endif %}
</div>
